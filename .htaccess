RewriteEngine On

# Ignoruj folder admin
RewriteRule ^admin/ - [L]

# 1. PRZEKIEROWANIE Z ZEWNĄTRZ: Usuń końcówki .php i .html z widocznego URL klienta
RewriteCond %{THE_REQUEST} \s/+(.*?/)?([^/.]+)\.(php|html)[\s?] [NC]
RewriteCond %{REQUEST_URI} !^/admin/
RewriteRule ^ /%1%2 [R=301,L,NE]

# 2. PRZEKIEROWANIE Z ZEWNĄTRZ: Usuń "pages/" z widocznego URL klienta
RewriteCond %{THE_REQUEST} \s/+(.*?/)?pages/([^/.]+)[\s?] [NC]
RewriteRule ^ /%1%2 [R=301,L,NE]

# 3. WEWNĘTRZNE PRZEKAZYWANIE: Jeśli plik lub katalog istnieje, po prostu go obsłuż
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 4. WEWNĘTRZNE PRZEKAZYWANIE: Szukaj plików .php i .html w katalogu głównym
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 5. WEWNĘTRZNE PRZEKAZYWANIE: Szukaj plików .php i .html w folderze pages/
# Zapobiega zapętleniu
RewriteCond %{REQUEST_URI} !^/pages/
# Używamy zmiennej bazowej, na wypadek gdyby strona była w podfolderze
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.php -f [OR]
RewriteCond %{SCRIPT_FILENAME}.php -f
RewriteRule ^(.*)$ pages/$1.php [L]

RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f [OR]
RewriteCond %{SCRIPT_FILENAME}.html -f
RewriteRule ^(.*)$ pages/$1.html [L]

# Fallback jeśli DocumentRoot jest dziwny (częste na współdzielonych hostingach):
# Jeśli nic nie dopasowało powyżej w pages/, spróbuj prosto
RewriteCond %{REQUEST_URI} !^/pages/
RewriteRule ^(.*)$ pages/$1.php [L]
